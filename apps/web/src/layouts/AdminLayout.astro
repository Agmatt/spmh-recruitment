---
import '../styles/global.css';

interface Props {
  title: string;
  active: 'applications' | 'jobs' | 'volunteers' | 'partnerships';
  userEmail?: string;
}

const { title, active, userEmail } = Astro.props;

const user = Astro.locals.user;
const admin = Astro.locals.admin;

const email = user?.email ?? userEmail ?? '';
const fallbackName = email ? email.split('@')[0] : 'Admin';
const displayName =
  (admin?.full_name && admin.full_name.trim()) || fallbackName;
const initials = displayName
  .split(/\s+/)
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const tabs = [
  { key: 'applications' as const, label: 'Applications', href: '/admin' },
  { key: 'jobs' as const, label: 'Job Postings', href: '/admin/jobs' },
  {
    key: 'volunteers' as const,
    label: 'Volunteers',
    href: '/admin/volunteers',
  },
  {
    key: 'partnerships' as const,
    label: 'Partnerships',
    href: '/admin/partnerships',
  },
];
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title} — SPMH Recruitment Admin</title>
    <meta name='robots' content='noindex, nofollow' />
  </head>

  <body class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)]'>
    <header
      class='bg-white border-b border-[var(--color-border-soft)] sticky top-0 z-30'>
      <div class='max-w-7xl mx-auto px-4 sm:px-6'>
        <!-- Top row: brand + user -->
        <div class='flex items-center justify-between py-3.5 gap-4'>
          <!-- Brand: logo + hospital identity -->
          <div class='flex items-center gap-3 min-w-0'>
            <div
              class='relative w-11 h-11 rounded-xl overflow-hidden bg-[var(--color-brand)] shrink-0 ring-1 ring-black/5'>
              <span
                class='absolute inset-0 flex items-center justify-center text-white font-black text-lg select-none'>
                S
              </span>
              <img
                src='/logos/logo.png'
                alt="St. Paul's Mission Hospital"
                class='absolute inset-0 w-full h-full object-contain bg-white p-0.5'
                onerror='this.remove()'
              />
            </div>
            <div class='min-w-0 hidden sm:block'>
              <p
                class='text-[13px] font-bold leading-tight text-[var(--color-ink)] truncate'>
                St. Paul's Mission Hospital
              </p>
              <p
                class='text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--color-brand)] mt-0.5'>
                Recruitment Portal
              </p>
            </div>
          </div>

          <!-- User pill + Sign out -->
          <div class='flex items-center gap-2 sm:gap-3 shrink-0'>
            <div
              class='flex items-center gap-2.5 pl-1 pr-1 sm:pl-1.5 sm:pr-3 py-1 rounded-full bg-[var(--color-warm)] border border-[var(--color-border-soft)]'>
              <div
                class='w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[var(--color-brand)] text-white font-bold text-[11px] sm:text-xs flex items-center justify-center shrink-0'>
                {initials || 'A'}
              </div>
              <div class='min-w-0 hidden sm:block'>
                <p
                  class='text-[12px] font-bold text-[var(--color-ink)] leading-tight truncate max-w-[160px]'>
                  {displayName}
                </p>
                <p
                  class='text-[10px] text-gray-400 leading-tight truncate max-w-[160px]'>
                  {email}
                </p>
              </div>
            </div>

            <form method='POST' action='/api/auth/signout'>
              <button
                type='submit'
                class='group inline-flex items-center gap-2 px-3 sm:px-4 py-2 rounded-xl bg-white border border-[var(--color-border-soft)] text-[12px] font-bold text-[var(--color-ink)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition-colors'
                title='Sign out'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='w-3.5 h-3.5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2.2'
                  aria-hidden='true'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1'
                  ></path>
                </svg>
                <span class='hidden sm:inline'>Sign out</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Tabs row -->
        <nav class='-mb-px'>
          <ul class='flex gap-1 overflow-x-auto'>
            {
              tabs.map((t) => (
                <li>
                  <a
                    href={t.href}
                    class:list={[
                      'inline-block px-4 py-3 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap',
                      active === t.key
                        ? 'border-[var(--color-brand)] text-[var(--color-brand)]'
                        : 'border-transparent text-gray-400 hover:text-[var(--color-ink)]',
                    ]}>
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class='max-w-7xl mx-auto px-4 sm:px-6 py-8'>
      <slot />
    </main>

    <script is:inline>
      (function () {
        var IDLE_LIMIT_MS = 10 * 60 * 1000; // 10 minutes
        var WARN_BEFORE_MS = 60 * 1000; // show warning 60s before

        var idleTimer = null;
        var warnTimer = null;
        var countdownTimer = null;
        var warnEl = null;

        function clearAll() {
          if (idleTimer) clearTimeout(idleTimer);
          if (warnTimer) clearTimeout(warnTimer);
          if (countdownTimer) clearInterval(countdownTimer);
          if (warnEl && warnEl.parentNode)
            warnEl.parentNode.removeChild(warnEl);
          idleTimer = warnTimer = countdownTimer = null;
          warnEl = null;
        }

        function logout() {
          clearAll();
          fetch('/api/auth/signout', {
            method: 'POST',
            credentials: 'same-origin',
          })
            .catch(function () {})
            .finally(function () {
              window.location.href = '/admin/login?reason=idle';
            });
        }

        function showWarning() {
          warnEl = document.createElement('div');
          warnEl.setAttribute('role', 'alertdialog');
          warnEl.setAttribute('aria-modal', 'true');
          warnEl.innerHTML =
            '<div style="position:fixed;inset:0;background:rgba(15,15,20,0.55);backdrop-filter:blur(2px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;font-family:system-ui,-apple-system,sans-serif;">' +
            '<div style="background:#fff;border-radius:18px;padding:30px;max-width:430px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,0.25);border:1px solid #ece8e1;">' +
            '<p style="font-size:11px;font-weight:800;letter-spacing:0.22em;color:#860f0f;text-transform:uppercase;margin:0 0 10px;">Session expiring</p>' +
            '<h2 style="font-size:20px;font-weight:800;margin:0 0 8px;color:#1c1c1e;letter-spacing:-0.01em;">You\'ve been idle</h2>' +
            '<p style="font-size:14px;color:#6b7280;line-height:1.6;margin:0 0 22px;">' +
            'For security, you\'ll be signed out in <strong id="idle-countdown" style="color:#860f0f;">60</strong> seconds.' +
            '</p>' +
            '<button id="idle-stay" style="width:100%;padding:13px;background:#860f0f;color:#fff;font-weight:700;font-size:14px;border:0;border-radius:11px;cursor:pointer;font-family:inherit;">' +
            'Stay signed in' +
            '</button>' +
            '</div>' +
            '</div>';
          document.body.appendChild(warnEl);

          var count = Math.round(WARN_BEFORE_MS / 1000);
          var el = warnEl.querySelector('#idle-countdown');
          countdownTimer = setInterval(function () {
            count--;
            if (el) el.textContent = String(Math.max(count, 0));
            if (count <= 0 && countdownTimer) {
              clearInterval(countdownTimer);
              countdownTimer = null;
            }
          }, 1000);

          var stayBtn = warnEl.querySelector('#idle-stay');
          if (stayBtn) {
            stayBtn.addEventListener('click', function (e) {
              e.preventDefault();
              reset();
            });
          }
        }

        function scheduleAll() {
          clearAll();
          warnTimer = setTimeout(showWarning, IDLE_LIMIT_MS - WARN_BEFORE_MS);
          idleTimer = setTimeout(logout, IDLE_LIMIT_MS);
        }

        function reset() {
          scheduleAll();
        }

        var events = [
          'mousemove',
          'mousedown',
          'keydown',
          'scroll',
          'touchstart',
          'click',
        ];
        events.forEach(function (evt) {
          window.addEventListener(evt, reset, { passive: true });
        });

        scheduleAll();
      })();
    </script>
  </body>
</html>
