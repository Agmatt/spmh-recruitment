---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title,
  description = "Career opportunities at St. Paul's Mission Hospital, Homa Bay, Kenya.",
  canonicalPath = '/',
  ogImage = 'https://recruitment.spmh.co.ke/img/8.jpg',
} = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, '') ?? 'https://recruitment.spmh.co.ke';
const canonical = `${site}${canonicalPath}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonical} />
    <link rel='icon' type='image/png' href='/file.svg' />

    <!-- Font Awesome -->
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
      integrity='sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=='
      crossorigin='anonymous'
      referrerpolicy='no-referrer'
    />

    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImage} />
    <meta
      property='og:site_name'
      content="St. Paul's Mission Hospital Careers"
    />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImage} />
  </head>

  <body
    class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)] antialiased'>
    <!-- ══ HEADER ═════════════════════════════════════════════════ -->
    <header
      class='border-b border-[var(--color-border-soft)] bg-white sticky top-0 z-40'>
      <div
        class='max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-4'>
        <a href='/' class='flex items-center gap-3 group min-w-0'>
          <div
            class='w-9 h-9 rounded-lg flex items-center justify-center overflow-hidden shrink-0'>
            <img
              src='/logos/logo.png'
              alt=''
              class='w-full h-full object-contain p-1'
            />
          </div>
          <div class='leading-tight min-w-0 hidden sm:block'>
            <p class='text-[13px] font-bold text-[var(--color-ink)] truncate'>
              St. Paul's Mission Hospital
            </p>
            <p
              class='text-[10px] font-semibold uppercase tracking-[0.22em] text-[var(--color-brand)]'>
              Careers
            </p>
          </div>
          <p
            class='sm:hidden text-[12px] font-bold text-[var(--color-ink)] truncate'>
            SPMH Careers
          </p>
        </a>

        <a
          href='https://www.spmh.co.ke'
          target='_blank'
          rel='noopener'
          class='inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 rounded-lg border border-[var(--color-border-soft)] bg-[var(--color-warm)] text-[12px] font-semibold text-[var(--color-ink)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] hover:bg-white transition-colors shrink-0'>
          <span class='hidden sm:inline'>Visit main site</span>
          <span class='sm:hidden'>Main site</span>
          <i class='fa-solid fa-arrow-up-right-from-square text-[10px]'></i>
        </a>
      </div>
    </header>

    <!-- ══ CONTENT ════════════════════════════════════════════════ -->
    <main>
      <slot />
    </main>

    <!-- ══ FOOTER ═════════════════════════════════════════════════ -->
    <footer class='mt-24 bg-[#141416] text-white/70'>
      <div class='max-w-6xl mx-auto px-5 sm:px-8 py-16'>
        <div class='grid gap-12 lg:gap-14 lg:grid-cols-[1.4fr_1fr_1fr_1fr]'>
          <!-- Column 1 — Brand -->
          <div>
            <div class='flex items-center gap-3 mb-5'>
              <div
                class='w-11 h-11 rounded-xl flex items-center justify-center overflow-hidden shrink-0'>
                <img
                  src='/logos/logo.png'
                  alt=''
                  class='w-full h-full object-contain p-1.5'
                />
              </div>
              <div class='leading-tight'>
                <p class='text-[13px] font-bold text-white'>
                  St. Paul's Mission Hospital
                </p>
                <p
                  class='text-[10px] font-semibold uppercase tracking-[0.22em] text-white/50'>
                  Careers
                </p>
              </div>
            </div>

            <p class='text-[13px] leading-[1.7] text-white/55 max-w-xs mb-5'>
              A faith-based Level IV mission hospital under the Catholic Diocese
              of Homa Bay, serving Homa Bay County with compassion, dignity, and
              clinical excellence.
            </p>

            <p class='text-[12px] leading-relaxed text-white/45 italic'>
              "Healing Hands, Caring Hearts"
            </p>
          </div>

          <!-- Column 2 — Discover -->
          <div>
            <p
              class='text-[10px] font-bold uppercase tracking-[0.24em] text-white/40 mb-5'>
              Discover
            </p>
            <ul class='space-y-3 text-[13px]'>
              <li>
                <a
                  href='https://www.spmh.co.ke/about-us/history' target="_blank"
                  class='text-white/65 hover:text-white transition-colors'
                  >Who we are</a
                >
              </li>
              <li>
                <a
                  href='https://www.spmh.co.ke/services/clinical' target="_blank"
                  class='text-white/65 hover:text-white transition-colors'
                  >Our services</a
                >
              </li>
              <li>
                <a
                  href='https://www.spmh.co.ke/volunteer' target="_blank"
                  class='text-white/65 hover:text-white transition-colors'
                  >Volunteer with us</a
                >
              </li>
              <li>
                <a
                  href='https://www.spmh.co.ke/partner' target="_blank"
                  class='text-white/65 hover:text-white transition-colors'
                  >Partner with us</a
                >
              </li>
              <li>
                <a
                  href='https://newsroom.spmh.co.ke' target="_blank"
                  class='text-white/65 hover:text-white transition-colors'
                  >Our stories</a
                >
              </li>
            </ul>
          </div>

          <!-- Column 3 — Legal -->
          <div>
            <p
              class='text-[10px] font-bold uppercase tracking-[0.24em] text-white/40 mb-5'>
              Legal
            </p>
            <ul class='space-y-3 text-[13px]'>
              <li>
                <a
                  href='/code-of-conduct'
                  class='text-white/65 hover:text-white transition-colors'
                  >Code of conduct</a
                >
              </li>
              <li>
                <a
                  href='/terms'
                  class='text-white/65 hover:text-white transition-colors'
                  >Terms &amp; conditions</a
                >
              </li>
              <li>
                <a
                  href='/privacy'
                  class='text-white/65 hover:text-white transition-colors'
                  >Privacy notice</a
                >
              </li>
            </ul>
          </div>

          <!-- Column 4 — Contact -->
          <div>
            <p
              class='text-[10px] font-bold uppercase tracking-[0.24em] text-white/40 mb-5'>
              Contact
            </p>
            <ul class='space-y-4 text-[13px]'>
              <li class='flex items-start gap-3'>
                <i
                  class='fa-solid fa-envelope text-white/35 mt-0.5 w-4 text-center'
                ></i>
                <a
                  href='mailto:recruitment@spmh.co.ke'
                  class='text-white/65 hover:text-white transition-colors break-all'>
                  recruitment@spmh.co.ke
                </a>
              </li>
              <li class='flex items-start gap-3'>
                <i
                  class='fa-solid fa-location-dot text-white/35 mt-0.5 w-4 text-center'
                ></i>
                <span class='text-white/55 leading-relaxed'>
                  P.O. Box 426, Homa Bay, Kenya
                </span>
              </li>
              <li class='flex items-start gap-3'>
                <i
                  class='fa-solid fa-globe text-white/35 mt-0.5 w-4 text-center'
                ></i>
                <a
                  href='https://www.spmh.co.ke'
                  target='_blank'
                  rel='noopener'
                  class='text-white/65 hover:text-white transition-colors'>
                  www.spmh.co.ke
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class='border-t border-white/10'>
        <div
          class='max-w-6xl mx-auto px-5 sm:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-white/40'>
          <p class='text-center sm:text-left'>
            © {year} St. Paul's Mission Hospital. All rights reserved.
          </p>
          <p class='text-center sm:text-right'>
            A healthcare ministry of the Catholic Diocese of Homa Bay
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
