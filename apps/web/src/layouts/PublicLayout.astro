---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title,
  description = "Explore medical, clinical, and administrative opportunities at St. Paul's Mission Hospital in Homa Bay, Kenya.",
  canonicalPath = '/',
  ogImage = 'https://recruitment.spmh.co.ke/img/8.jpg',
} = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, '') ?? 'https://recruitment.spmh.co.ke';
const canonical = `${site}${canonicalPath}`;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonical} />
    <link rel='icon' type='image/png' href='/file.svg' />

    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImage} />
    <meta
      property='og:site_name'
      content="St. Paul's Mission Hospital Careers"
    />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImage} />
  </head>

  <body
    class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)] antialiased'>
    <!-- ══ HEADER ═════════════════════════════════════════════ -->
    <header
      class='border-b border-[var(--color-border-soft)] bg-white/80 backdrop-blur-md sticky top-0 z-40'>
      <div
        class='max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between'>
        <a href='/' class='flex items-center gap-3 group'>
          <div
            class='w-9 h-9 rounded-lg bg-[var(--color-brand)] flex items-center justify-center overflow-hidden shrink-0'>
            <img
              src='/spmh-logo.png'
              alt=''
              class='w-full h-full object-contain p-1'
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span
              class='text-white font-black text-base hidden'
              style='display:none;'>S</span
            >
          </div>
          <div class='leading-tight'>
            <p
              class='text-[13px] font-bold text-[var(--color-ink)] group-hover:text-[var(--color-brand)] transition-colors'>
              St. Paul's Mission Hospital
            </p>
            <p
              class='text-[10px] font-bold uppercase tracking-[0.22em] text-[var(--color-brand)]'>
              Careers
            </p>
          </div>
        </a>

        <nav class='flex items-center gap-1 sm:gap-2'>
          <a
            href='/#openings'
            class='hidden sm:inline-block px-3.5 py-2 text-xs font-semibold text-gray-500 hover:text-[var(--color-brand)] transition-colors'>
            Openings
          </a>
          <a
            href='mailto:recruitment@spmh.co.ke'
            class='hidden sm:inline-block px-3.5 py-2 text-xs font-semibold text-gray-500 hover:text-[var(--color-brand)] transition-colors'>
            Contact HR
          </a>
          <a
            href='https://www.spmh.co.ke'
            target='_blank'
            rel='noopener'
            class='inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold text-[var(--color-ink)] bg-[var(--color-warm)] border border-[var(--color-border-soft)] hover:border-[var(--color-brand)] transition-colors'>
            Main site
            <svg
              class='w-3 h-3'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2.5'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- ══ CONTENT ════════════════════════════════════════════ -->
    <main>
      <slot />
    </main>

    <!-- ══ FOOTER ═════════════════════════════════════════════ -->
    <footer class='mt-24 border-t border-[var(--color-border-soft)] bg-white'>
      <div
        class='max-w-6xl mx-auto px-5 sm:px-8 py-12 grid sm:grid-cols-3 gap-10'>
        <div>
          <p class='text-sm font-bold text-[var(--color-ink)] mb-1'>
            St. Paul's Mission Hospital
          </p>
          <p class='text-xs text-gray-500 leading-relaxed'>
            Building the team behind the care. Serving Homa Bay County and
            beyond.
          </p>
        </div>
        <div>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--color-brand)] mb-3'>
            Contact
          </p>
          <ul class='space-y-1.5 text-xs text-gray-500'>
            <li>
              <a
                href='mailto:recruitment@spmh.co.ke'
                class='hover:text-[var(--color-brand)] transition-colors'>
                recruitment@spmh.co.ke
              </a>
            </li>
            <li>
              <a
                href='https://www.spmh.co.ke'
                class='hover:text-[var(--color-brand)] transition-colors'>
                www.spmh.co.ke
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--color-brand)] mb-3'>
            Candidate Info
          </p>
          <ul class='space-y-1.5 text-xs text-gray-500'>
            <li>
              <a
                href='/privacy'
                class='hover:text-[var(--color-brand)] transition-colors'
                >Privacy notice</a>
            </li>
            <li>
              <a
                href='mailto:recruitment@spmh.co.ke?subject=Data%20access%20request'
                class='hover:text-[var(--color-brand)] transition-colors'
                >Data access request</a>
            </li>
          </ul>
        </div>
      </div>
      <div class='border-t border-[var(--color-border-soft)]'>
        <div
          class='max-w-6xl mx-auto px-5 sm:px-8 py-5 text-center sm:text-left text-[11px] text-gray-400'>
          © {new Date().getFullYear()} St. Paul's Mission Hospital. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
