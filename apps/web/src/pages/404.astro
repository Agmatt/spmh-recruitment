---
import '../styles/global.css';
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Page not found — SPMH Careers</title>
    <link rel='icon' type='image/png' href='/file.svg' />
  </head>
  <body
    class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)] flex items-center justify-center px-6'>
    <div class='text-center max-w-md'>
      <p
        class='text-xs font-bold uppercase tracking-[0.25em] text-[var(--color-brand)] mb-4'>
        Error 404
      </p>
      <h1 class='text-3xl font-black tracking-tight mb-3'>
        We couldn't find that page
      </h1>
      <p class='text-sm text-gray-500 mb-8'>
        The link may be broken, or the position you're looking for may have been
        closed. Head back to the careers page to see what's open.
      </p>
      <a
        href='/'
        class='inline-block px-6 py-3 bg-[var(--color-brand)] text-white text-sm font-bold rounded-xl hover:bg-[var(--color-brand-hover)] transition-colors'>
        Back to Careers
      </a>
    </div>
  </body>
</html>
