---
import '../../styles/global.css';
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Set your password — SPMH Recruitment</title>
    <meta name='robots' content='noindex, nofollow' />
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
      integrity='sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=='
      crossorigin='anonymous'
      referrerpolicy='no-referrer'
    />
  </head>

  <body
    class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)] flex items-center justify-center px-6'>
    <div class='w-full max-w-sm'>
      <div class='text-center mb-8'>
        <div
          class='inline-flex w-14 h-14 rounded-2xl bg-white border border-[var(--color-border-soft)] shadow-sm items-center justify-center mb-4 overflow-hidden'>
          <img
            src='/spmh-logo.png'
            alt=''
            class='w-full h-full object-contain p-2'
          />
        </div>
        <p
          class='text-[11px] font-bold uppercase tracking-[0.25em] text-[var(--color-brand)]'>
          St. Paul's Mission Hospital
        </p>
      </div>

      <div
        class='bg-white border border-[var(--color-border-soft)] rounded-2xl p-7'>
        <h1 class='text-2xl font-black tracking-tight mb-2'>
          Set your password
        </h1>
        <p class='text-sm text-gray-500 mb-6' id='subtitle'>
          Choose a password to activate your account.
        </p>

        <div id='status' class='hidden mb-5 text-xs rounded-xl px-4 py-3'></div>

        <form id='password-form' class='space-y-4 hidden'>
          <div>
            <label for='password' class='block text-xs font-semibold mb-1.5'>
              New password
            </label>
            <input
              id='password'
              type='password'
              required
              minlength={10}
              autocomplete='new-password'
              placeholder='At least 10 characters'
              class='w-full px-3.5 py-2.5 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/10'
            />
          </div>
          <div>
            <label for='confirm' class='block text-xs font-semibold mb-1.5'>
              Confirm password
            </label>
            <input
              id='confirm'
              type='password'
              required
              minlength={10}
              autocomplete='new-password'
              placeholder='Type it again'
              class='w-full px-3.5 py-2.5 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-2 focus:ring-[var(--color-brand)]/10'
            />
          </div>

          <button
            type='submit'
            class='w-full py-3 bg-[var(--color-brand)] text-white font-bold text-sm rounded-xl hover:bg-[var(--color-brand-hover)] transition-colors'>
            Set password and continue
          </button>
        </form>
      </div>

      <p class='text-[11px] text-gray-400 text-center mt-6 leading-relaxed'>
        Link expired? Ask your super admin to send a new invite, or use
        <a href='/admin/login' class='underline'>the login page</a>.
      </p>
    </div>

    <script>
      import { createBrowserClient } from '@supabase/ssr';

      const statusEl = document.getElementById('status');
      const subtitleEl = document.getElementById('subtitle');
      const formEl = document.getElementById('password-form');

      function showStatus(kind, message) {
        if (!statusEl) return;
        statusEl.classList.remove('hidden');
        statusEl.className = 'mb-5 text-xs rounded-xl px-4 py-3';
        if (kind === 'error') {
          statusEl.classList.add(
            'bg-red-50',
            'text-red-800',
            'border',
            'border-red-200',
          );
        } else if (kind === 'success') {
          statusEl.classList.add(
            'bg-emerald-50',
            'text-emerald-900',
            'border',
            'border-emerald-200',
          );
        } else {
          statusEl.classList.add(
            'bg-amber-50',
            'text-amber-900',
            'border',
            'border-amber-200',
          );
        }
        statusEl.textContent = message;
      }

      const supabase = createBrowserClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
        {
          auth: {
            detectSessionInUrl: true,
            flowType: 'pkce',
          },
        },
      );

      // Wait briefly for supabase-js to consume the invite/recovery tokens
      // embedded in the URL fragment.
      let waited = 0;
      const tick = setInterval(async () => {
        waited += 300;
        const {
          data: { session },
        } = await supabase.auth.getSession();
        if (session) {
          clearInterval(tick);
          subtitleEl.textContent = `Welcome, ${session.user.email}. Choose a password to activate your account.`;
          formEl.classList.remove('hidden');
          return;
        }
        if (waited >= 6000) {
          clearInterval(tick);
          showStatus(
            'error',
            'We could not find a valid invite link. It may have expired. Ask your super admin to send a new one.',
          );
        }
      }, 300);

      formEl?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = document.getElementById('password').value;
        const confirm = document.getElementById('confirm').value;

        if (password !== confirm) {
          showStatus('error', 'Passwords do not match.');
          return;
        }
        if (password.length < 10) {
          showStatus('error', 'Password must be at least 10 characters.');
          return;
        }

        const btn = formEl.querySelector('button[type=submit]');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Setting password…';
        }

        const { error } = await supabase.auth.updateUser({ password });
        if (error) {
          showStatus('error', error.message);
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Set password and continue';
          }
          return;
        }

        showStatus('success', 'Password set. Redirecting to your dashboard…');
        setTimeout(() => {
          window.location.href = '/admin';
        }, 800);
      });
    </script>
  </body>
</html>
