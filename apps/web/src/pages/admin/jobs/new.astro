---
import { createSupabaseServerClient } from '../../../lib/supabase-ssr';
import { listDepartments } from '../../../lib/job-queries';
import JobForm from '../../../islands/JobForm.tsx';
import AdminLayout from '../../../layouts/AdminLayout.astro';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);
const departments = await listDepartments(supabase);
---

<AdminLayout title='New job' active='jobs' userEmail={user?.email ?? ''}>
  <div class='mb-6'>
    <a
      href='/admin/jobs'
      class='text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-brand)] hover:opacity-80'>
      ← All jobs
    </a>
    <h1 class='text-2xl font-black tracking-tight mt-3'>Create job posting</h1>
    <p class='text-sm text-gray-500 mt-1'>
      Fill in the details. You'll publish it on the next screen.
    </p>
  </div>

  <JobForm
    client:load
    mode='create'
    departments={departments.map((d) => ({
      id: d.id,
      slug: d.slug,
      label: d.label,
    }))}
  />
</AdminLayout>
