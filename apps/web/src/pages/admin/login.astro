---
import '../../styles/global.css';

const errorMsg = Astro.url.searchParams.get('error');
const reason = Astro.url.searchParams.get('reason');
const idleLogout = reason === 'idle';
const signedOut = reason === 'signed-out';
const passwordSet = reason === 'password-set';
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Sign in — SPMH Recruitment Admin</title>
    <meta name='robots' content='noindex, nofollow' />
    <link rel='icon' type='image/png' href='/file.svg' />
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
      integrity='sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=='
      crossorigin='anonymous'
      referrerpolicy='no-referrer'
    />
  </head>

  <body class='min-h-screen'>
    <div class='min-h-screen grid lg:grid-cols-[1.05fr_1fr]'>
      <!-- ══ LEFT — Hero panel ═════════════════════════════════ -->
      <aside
        class='relative hidden lg:flex flex-col justify-between overflow-hidden bg-[#1c1c1e]'>
        <img
          src='/img/8.jpg'
          alt=''
          class='absolute inset-0 w-full h-full object-cover opacity-60'
          aria-hidden='true'
        />
        <div
          class='absolute inset-0 bg-gradient-to-br from-[#860f0f]/70 via-[#1c1c1e]/60 to-[#1c1c1e]/95'
          aria-hidden='true'>
        </div>
        <div
          class='absolute inset-0 opacity-[0.07]'
          style='background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;'
          aria-hidden='true'>
        </div>

        <div class='relative z-10 p-12'>
          <div class='flex items-center gap-3'>
            <div
              class='w-11 h-11 rounded-xl flex items-center justify-center overflow-hidden'>
              <img
                src='/logos/logo.png'
                alt='SPMH'
                class='w-full h-full object-contain p-1'
              />
            </div>
            <div>
              <p class='text-white font-bold tracking-tight text-sm'>
                St. Paul's Mission Hospital
              </p>
              <p class='text-white/50 text-[11px] tracking-[0.2em] uppercase'>
                Homa Bay, Kenya
              </p>
            </div>
          </div>
        </div>

        <div class='relative z-10 px-12 max-w-lg'>
          <p
            class='text-[10px] font-bold uppercase tracking-[0.3em] text-white/50 mb-4'>
            Recruitment Portal
          </p>
          <h1
            class='text-4xl xl:text-5xl font-black text-white leading-[1.1] tracking-tight mb-6'>
            Recruitment with purpose.
          </h1>
          <p class='text-white/70 text-sm leading-relaxed max-w-md'>
            Manage job postings, review applicants, and build the team that
            serves our community across Homa Bay County.
          </p>
        </div>

        <div class='relative z-10 p-12'>
          <div class='flex items-center gap-6 text-white/60 text-[11px]'>
            <div class='flex items-center gap-2'>
              <i class='fa-solid fa-shield-halved text-[12px]'></i>
              <span>Restricted access</span>
            </div>
            <span class='w-px h-3 bg-white/20'></span>
            <span>Authorised HR staff only</span>
          </div>
        </div>
      </aside>

      <!-- ══ RIGHT — Form panel ═════════════════════════════════ -->
      <main class='flex items-center justify-center px-6 py-12 lg:py-0'>
        <div class='w-full max-w-sm'>
          <!-- Brand block -->
          <div class='mb-8 flex justify-center'>
            <div
              class='w-20 h-20 rounded-2xl bg-white border border-[var(--color-border-soft)] shadow-sm flex items-center justify-center overflow-hidden'>
              <img
                src='/logos/logo.png'
                alt=''
                class='w-full h-full object-contain p-2'
              />
            </div>
          </div>

          <div class='mb-8 text-center'>
            <h2 class='text-3xl font-black tracking-tight mb-2'>Sign in</h2>
            <p class='text-sm text-gray-500'>
              Access the recruitment dashboard.
            </p>
          </div>

          {
            idleLogout && !errorMsg && (
              <div class='mb-5 flex items-start gap-3 text-xs text-amber-900 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3'>
                <i class='fa-regular fa-clock mt-0.5' />
                <span>
                  You were signed out after 10 minutes of inactivity. Please
                  sign in again.
                </span>
              </div>
            )
          }
          {
            signedOut && !errorMsg && (
              <div class='mb-5 flex items-start gap-3 text-xs text-emerald-900 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3'>
                <i class='fa-solid fa-check mt-0.5' />
                <span>
                  You have been signed out. Please sign in again to continue.
                </span>
              </div>
            )
          }
          {
            passwordSet && !errorMsg && (
              <div class='mb-5 flex items-start gap-3 text-xs text-emerald-900 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3'>
                <i class='fa-solid fa-check mt-0.5' />
                <span>
                  Password set successfully. Sign in below to continue.
                </span>
              </div>
            )
          }
          {
            errorMsg && (
              <div class='mb-5 flex items-start gap-3 text-xs text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3'>
                <i class='fa-solid fa-circle-exclamation mt-0.5' />
                <span>{decodeURIComponent(errorMsg)}</span>
              </div>
            )
          }

          <form method='POST' action='/api/auth/signin' class='space-y-5'>
            <div>
              <label
                for='email'
                class='block text-xs font-semibold text-[var(--color-ink)] mb-2'>
                Email address
              </label>
              <input
                id='email'
                name='email'
                type='email'
                required
                autocomplete='email'
                autofocus
                class='w-full px-4 py-3 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-4 focus:ring-[var(--color-brand)]/10 transition-all placeholder:text-gray-300'
                placeholder='you@spmh.co.ke'
              />
            </div>

            <div>
              <div class='flex items-center justify-between mb-2'>
                <label
                  for='password'
                  class='block text-xs font-semibold text-[var(--color-ink)]'>
                  Password
                </label>
                <a
                  href='/admin/forgot-password'
                  class='text-[11px] font-medium text-[var(--color-brand)] hover:underline'>
                  Forgot password?
                </a>
              </div>
              <div class='relative'>
                <input
                  id='password'
                  name='password'
                  type='password'
                  required
                  autocomplete='current-password'
                  class='w-full px-4 py-3 pr-12 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-4 focus:ring-[var(--color-brand)]/10 transition-all placeholder:text-gray-300'
                  placeholder='••••••••'
                />
                <button
                  type='button'
                  data-toggle-password='password'
                  aria-label='Show password'
                  class='absolute right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-[var(--color-brand)] hover:bg-[var(--color-warm)] transition-colors'>
                  <i class='fa-regular fa-eye text-[13px]' data-eye-icon></i>
                </button>
              </div>
            </div>

            <button
              type='submit'
              class='w-full py-3.5 bg-[var(--color-brand)] text-white font-bold text-sm rounded-xl hover:bg-[var(--color-brand-hover)] active:scale-[0.99] transition-all shadow-lg shadow-[var(--color-brand)]/20'>
              Sign in to dashboard
            </button>
          </form>

          <div class='mt-10 pt-8 border-t border-[var(--color-border-soft)]'>
            <p class='text-[11px] text-gray-400 leading-relaxed text-center'>
              Access restricted to authorised HR staff. If you have lost access
              to your account, use the{' '}
              <a
                href='/admin/forgot-password'
                class='font-medium text-[var(--color-brand)] hover:underline'>
                password reset
              </a>{' '}
              or contact{' '}
              <a
                href='mailto:ict@spmh.co.ke'
                class='font-medium text-[var(--color-brand)] hover:underline'>
                ict@spmh.co.ke
              </a>
              .
            </p>
          </div>
        </div>
      </main>
    </div>

    <script>
      // ── Password visibility toggle ──────────────────────────
      document.querySelectorAll('[data-toggle-password]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-toggle-password');
          const input = document.getElementById(id) as HTMLInputElement | null;
          const icon = btn.querySelector(
            '[data-eye-icon]',
          ) as HTMLElement | null;
          if (!input) return;
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          if (icon)
            icon.className = show
              ? 'fa-regular fa-eye-slash text-[13px]'
              : 'fa-regular fa-eye text-[13px]';
          btn.setAttribute(
            'aria-label',
            show ? 'Hide password' : 'Show password',
          );
        });
      });
    </script>
  </body>
</html>
