---
import '../../styles/global.css';

const errorMsg = Astro.url.searchParams.get('error');
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Sign in — SPMH Recruitment Admin</title>
    <meta name='robots' content='noindex, nofollow' />
  </head>

  <body class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)]'>
    <div class='min-h-screen grid lg:grid-cols-[1.05fr_1fr]'>
      <!-- ══ LEFT — Hero panel ═════════════════════════════════ -->
      <aside
        class='relative hidden lg:flex flex-col justify-between overflow-hidden bg-[#1c1c1e]'>
        <!-- Background image -->
        <img
          src='/public/img/8.jpg'
          alt=''
          class='absolute inset-0 w-full h-full object-cover opacity-60'
          aria-hidden='true'
        />

        <!-- Overlays -->
        <div
          class='absolute inset-0 bg-gradient-to-br from-[#860f0f]/70 via-[#1c1c1e]/60 to-[#1c1c1e]/95'
          aria-hidden='true'>
        </div>
        <div
          class='absolute inset-0 opacity-[0.07]'
          style='background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;'
          aria-hidden='true'>
        </div>

        <!-- Top brand -->
        <div class='relative z-10 p-12'>
          <div class='flex items-center gap-3'>
            <div
              class='w-11 h-11 rounded-xl bg-white/10 backdrop-blur border border-white/20 flex items-center justify-center'>
              <span class='text-white font-black text-lg'>S</span>
            </div>
            <div>
              <p class='text-white font-bold tracking-tight text-sm'>
                St. Paul's Mission Hospital
              </p>
              <p class='text-white/50 text-[11px] tracking-[0.2em] uppercase'>
                Homa Bay, Kenya
              </p>
            </div>
          </div>
        </div>

        <!-- Centre headline -->
        <div class='relative z-10 px-12 max-w-lg'>
          <p
            class='text-[10px] font-bold uppercase tracking-[0.3em] text-white/50 mb-4'>
            Recruitment Portal
          </p>
          <h1
            class='text-4xl xl:text-5xl font-black text-white leading-[1.1] tracking-tight mb-6'>
            Where healing<br />
            meets purpose.
          </h1>
          <p class='text-white/70 text-sm leading-relaxed max-w-md'>
            Manage job postings, review applicants, and build the team that
            serves our community across Homa Bay County.
          </p>
        </div>

        <!-- Bottom trust bar -->
        <div class='relative z-10 p-12'>
          <div class='flex items-center gap-6 text-white/60 text-[11px]'>
            <div class='flex items-center gap-2'>
              <svg
                class='w-3.5 h-3.5'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2.2'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
                ></path>
              </svg>
              <span>Restricted access</span>
            </div>
            <span class='w-px h-3 bg-white/20'></span>
            <span>Authorised HR staff only</span>
          </div>
        </div>
      </aside>

      <!-- ══ RIGHT — Form panel ═════════════════════════════════ -->
      <main class='flex items-center justify-center px-6 py-12 lg:py-0'>
        <div class='w-full max-w-sm'>
          <!-- Mobile brand (hidden on desktop) -->
          <div class='lg:hidden text-center mb-8'>
            <div
              class='inline-flex w-12 h-12 rounded-xl bg-[var(--color-brand)] items-center justify-center mb-3'>
              <span class='text-white font-black text-lg'>S</span>
            </div>
            <p
              class='text-xs font-bold uppercase tracking-[0.25em] text-[var(--color-brand)]'>
              St. Paul's Mission Hospital
            </p>
          </div>

          <!-- Form header -->
          <div class='mb-8'>
            <h2 class='text-3xl font-black tracking-tight mb-2'>Sign in</h2>
            <p class='text-sm text-gray-500'>
              Access the recruitment dashboard.
            </p>
          </div>

          {
            errorMsg && (
              <div class='mb-5 flex items-start gap-3 text-xs text-red-800 bg-red-50 border border-red-200 rounded-xl px-4 py-3'>
                <svg
                  class='w-4 h-4 shrink-0 mt-0.5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  />
                </svg>
                <span>{decodeURIComponent(errorMsg)}</span>
              </div>
            )
          }

          <form method='POST' action='/api/auth/signin' class='space-y-5'>
            <div>
              <label
                for='email'
                class='block text-xs font-semibold text-[var(--color-ink)] mb-2'>
                Email address
              </label>
              <input
                id='email'
                name='email'
                type='email'
                required
                autocomplete='email'
                autofocus
                class='w-full px-4 py-3 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-4 focus:ring-[var(--color-brand)]/10 transition-all placeholder:text-gray-300'
                placeholder='you@spmh.co.ke'
              />
            </div>

            <div>
              <div class='flex items-center justify-between mb-2'>
                <label
                  for='password'
                  class='block text-xs font-semibold text-[var(--color-ink)]'>
                  Password
                </label>
                <a
                  href='mailto:info@spmh.co.ke?subject=Password%20reset%20request'
                  class='text-[11px] font-medium text-[var(--color-brand)] hover:underline'>
                  Forgot password?
                </a>
              </div>
              <input
                id='password'
                name='password'
                type='password'
                required
                autocomplete='current-password'
                class='w-full px-4 py-3 rounded-xl border border-[var(--color-border-soft)] text-sm bg-white outline-none focus:border-[var(--color-brand)] focus:ring-4 focus:ring-[var(--color-brand)]/10 transition-all placeholder:text-gray-300'
                placeholder='••••••••'
              />
            </div>

            <button
              type='submit'
              class='w-full py-3.5 bg-[var(--color-brand)] text-white font-bold text-sm rounded-xl hover:bg-[var(--color-brand-hover)] active:scale-[0.99] transition-all shadow-lg shadow-[var(--color-brand)]/20'>
              Sign in to dashboard
            </button>
          </form>

          <!-- Footer -->
          <div class='mt-10 pt-8 border-t border-[var(--color-border-soft)]'>
            <p class='text-[11px] text-gray-400 leading-relaxed text-center'>
              Access restricted to authorised HR staff. If you cannot sign in,
              contact{' '}
              <a
                href='mailto:info@spmh.co.ke'
                class='text-[var(--color-brand)] font-medium hover:underline'>
                info@spmh.co.ke
              </a>
              .
            </p>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
