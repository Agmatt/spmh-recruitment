---
import { createSupabaseServerClient } from '../../lib/supabase-ssr';
import { listAdmins } from '../../lib/admin-queries';
import AdminLayout from '../../layouts/AdminLayout.astro';
import TeamManagement from '../../islands/TeamManagement.tsx';

const user = Astro.locals.user;
const admin = Astro.locals.admin;

// Only super admins see this page
if (!admin || admin.role !== 'super_admin') {
  return Astro.redirect('/admin');
}

const supabase = createSupabaseServerClient(Astro);
const members = await listAdmins(supabase);
---

<AdminLayout title='Team' active='team' userEmail={user?.email ?? ''}>
  <div class='mb-6'>
    <h1 class='text-2xl font-black tracking-tight mb-1'>Team</h1>
    <p class='text-sm text-gray-500'>
      Manage who has access to this recruitment dashboard.
    </p>
  </div>

  <TeamManagement
    client:load
    initial={members}
    currentUserId={user?.id ?? ''}
  />
</AdminLayout>
