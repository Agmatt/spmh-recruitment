---
import { createSupabaseServerClient } from '../../lib/supabase-ssr';
import { listVolunteers } from '../../lib/volunteer-queries';
import AdminLayout from '../../layouts/AdminLayout.astro';
import VolunteersAdminDashboard from '../../islands/VolunteersAdminDashboard.tsx';

const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);
const volunteers = await listVolunteers(supabase);
---

<AdminLayout
  title='Volunteers'
  active='volunteers'
  userEmail={user?.email ?? ''}>
  <div class='mb-6 flex items-start justify-between gap-6 flex-wrap'>
    <div>
      <h1 class='text-2xl font-black tracking-tight mb-1'>Volunteers</h1>
      <p class='text-sm text-gray-500'>
        Expressions of interest submitted through the public site.
      </p>
    </div>
    <div class='flex gap-2'>
      <a
        href='/api/export-volunteers/csv'
        class='px-4 py-2.5 bg-white border border-[var(--color-border-soft)] text-[var(--color-ink)] text-xs font-bold rounded-xl hover:border-[var(--color-brand)] transition-colors'>
        CSV
      </a>
      <a
        href='/api/export-volunteers/xlsx'
        class='px-4 py-2.5 bg-[var(--color-brand)] text-white text-xs font-bold rounded-xl hover:bg-[var(--color-brand-hover)] transition-colors'>
        Excel
      </a>
    </div>
  </div>

  <VolunteersAdminDashboard client:load initial={volunteers} />
</AdminLayout>
