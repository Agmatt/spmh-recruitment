                      aria-hidden='true'>
                      <i class='fa-solid fa-arrow-right text-[12px]' />
                    </span>
                  </div>

                  {job.summary && (
                    <p class='mt-3 text-[13px] text-gray-500 leading-[1.7]'>
                      {job.summary}
                    </p>
                  )}

                  <div class='mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-[11px] sm:text-[12px]'>
                    {job.vacancies_needed > 1 && (
                      <>
                        <span class='inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-800 font-semibold'>
                          <i class='fa-solid fa-users text-[10px]' />
