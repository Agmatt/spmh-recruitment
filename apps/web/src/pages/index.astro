                      </>
                    )}
                    {job.isClosingSoon && (
                      <>
                        <span class='w-1 h-1 rounded-full bg-gray-300' />
                        <span class='text-amber-700 font-semibold'>
                          <i class='fa-regular fa-clock mr-1 text-[10px]' />
                          Closes in {job.daysLeft}
                          {job.daysLeft === 1 ? ' day' : ' days'}
                        </span>
                      </>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        preparedJobs.length > 0 && (
          <p class='mt-8 text-[14px] sm:text-[16px] text-gray-500 leading-relaxed max-w-2xl'>
            Applications are reviewed on a rolling basis. Only shortlisted
            candidates will be contacted. For enquiries, contact the Human
            Resources Department at{' '}
            <a
              href='mailto:recruitment@spmh.co.ke'
              class='text-[var(--color-brand)] underline underline-offset-4 decoration-1 hover:decoration-2'>
              recruitment@spmh.co.ke
            </a>
            .
          </p>
        )
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- WHY CHOOSE US                                               -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='bg-white border-b border-[var(--color-border-soft)]'>
    <div class='max-w-6xl mx-auto px-4 sm:px-10 py-20 sm:py-24'>
      <div
        class='grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-12 lg:gap-20 items-start'>
        <!-- Left: image + heading -->
        <div class='lg:sticky lg:top-24'>
          <p
            class='text-[11px] font-bold uppercase tracking-[0.24em] text-[var(--color-brand)] mb-3'>
            Why SPMH
          </p>
          <h2
            class='text-[1.75rem] sm:text-4xl font-black tracking-[-0.02em] leading-[1.12] text-[var(--color-ink)] mb-5'>
            Build a career with meaning.
          </h2>
          <p class='text-[14px] text-gray-500 leading-[1.75] mb-8 max-w-md'>
            We are committed to staff who are committed to patients. Here is
            what you can expect when you join the SPMH team.
          </p>

          <div
            class='rounded-2xl overflow-hidden aspect-[4/3] bg-[#141416] border border-[var(--color-border-soft)]'>
            <img
              src='/gallery/11.jpg'
              alt='SPMH staff at work'
              class='w-full h-full object-cover'
            />
