---
import '../styles/global.css';
import { supabase } from '../lib/supabase';
import type { JobWithDepartment } from '../lib/types';

const { data, error } = await supabase
  .from('job_postings')
  .select(
    `
    *,
    departments ( slug, label )
  `,
  )
  .eq('status', 'published')
  .order('published_at', { ascending: false });

if (error) console.error('[index.astro] Supabase error:', error);

const jobs = (data ?? []) as JobWithDepartment[];
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Careers at St. Paul's Mission Hospital</title>
    <meta
      name='description'
      content="Explore medical, clinical, and administrative opportunities at St. Paul's Mission Hospital in Homa Bay."
    />
  </head>
  <body class='min-h-screen bg-[var(--color-warm)] text-[var(--color-ink)]'>
    <main class='max-w-5xl mx-auto px-6 py-16'>
      <header class='mb-14'>
        <p
          class='text-xs font-bold uppercase tracking-[0.25em] text-[var(--color-brand)] mb-3'>
          St. Paul's Mission Hospital
        </p>
        <h1 class='text-5xl font-black tracking-tight'>Careers</h1>
        <p class='mt-4 text-gray-600 max-w-2xl'>
          Build a meaningful career in healthcare. Explore our current openings
          below.
        </p>
      </header>

      <section>
        <div class='flex items-baseline justify-between mb-6'>
          <h2
            class='text-xs font-bold uppercase tracking-[0.25em] text-[var(--color-brand)]'>
            Current Openings
          </h2>
          <span class='text-xs text-gray-400'>
            {jobs.length}
            {jobs.length === 1 ? 'role' : 'roles'}
          </span>
        </div>

        {
          jobs.length === 0 ? (
            <div class='bg-white border border-[var(--color-border-soft)] rounded-2xl p-10 text-center'>
              <p class='text-gray-500'>
                No current openings. Please check back soon.
              </p>
            </div>
          ) : (
            <ul class='space-y-3'>
              {jobs.map((job) => (
                <li>
                  <a
                    href={`/jobs/${job.slug}`}
                    class='block bg-white border border-[var(--color-border-soft)] rounded-2xl p-6 hover:border-[var(--color-brand)] hover:shadow-md transition-all'>
                    <div class='flex items-start justify-between gap-6'>
                      <div class='min-w-0'>
                        <h3 class='font-bold text-lg'>{job.title}</h3>
                        {job.departments && (
                          <p class='text-xs font-medium text-[var(--color-brand)] mt-1'>
                            {job.departments.label}
                          </p>
                        )}
                        {job.summary && (
                          <p class='text-sm text-gray-500 mt-3 line-clamp-2'>
                            {job.summary}
                          </p>
                        )}
                      </div>
                      <div class='text-right shrink-0'>
                        <span class='inline-block text-xs font-medium px-3 py-1 rounded-full bg-[var(--color-warm)] text-gray-600 capitalize'>
                          {job.employment_type.replace('_', ' ')}
                        </span>
                        <p class='text-xs text-gray-400 mt-2'>{job.location}</p>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
  </body>
</html>
