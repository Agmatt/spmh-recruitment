                      </>
                    )}
                    <span class='inline-flex items-center px-2.5 py-0.5 rounded-md bg-[var(--color-warm)] text-gray-600 font-medium'>
                      {job.employmentLabel}
                    </span>
                    <span class='text-gray-400'>
