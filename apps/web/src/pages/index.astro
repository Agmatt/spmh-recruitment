---
import { supabase } from '../lib/supabase';
import type { JobWithDepartment } from '../lib/types';
import PublicLayout from '../layouts/PublicLayout.astro';

const { data, error } = await supabase
  .from('job_postings')
  .select('*, departments ( slug, label )')
  .eq('status', 'published')
  .order('published_at', { ascending: false });

if (error) console.error('[index.astro] Supabase error:', error);
const jobs = (data ?? []) as JobWithDepartment[];

const jobCount = jobs.length;
const jobCountLabel =
  jobCount === 0
    ? 'No positions currently listed'
    : jobCount === 1
      ? 'One position'
      : `${jobCount} positions`;

const employmentLabels: Record<string, string> = {
  full_time: 'Full time',
  part_time: 'Part time',
  contract: 'Contract',
  internship: 'Internship',
  locum: 'Locum',
};

const preparedJobs = jobs.map((job) => {
  const closesDate = job.closes_at ? new Date(job.closes_at) : null;
  let daysLeft: number | null = null;
  let isClosingSoon = false;
  if (closesDate) {
    daysLeft = Math.ceil((closesDate.getTime() - Date.now()) / 86400000);
    if (daysLeft > 0 && daysLeft < 8) isClosingSoon = true;
  }
  const postedDate = job.published_at ? new Date(job.published_at) : null;
  const postedLabel = postedDate
    ? postedDate.toLocaleDateString('en-KE', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : null;
  return {
    id: job.id,
    slug: job.slug,
    title: job.title,
    summary: job.summary,
    location: job.location,
    departmentLabel: job.departments?.label ?? null,
    employmentLabel:
      employmentLabels[job.employment_type] ?? job.employment_type,
    isClosingSoon,
    daysLeft,
    postedLabel,
  };
});

const today = new Date().toLocaleDateString('en-KE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const values = [
  {
    icon: 'fa-solid fa-user-doctor',
    title: 'Professionalism',
    body: 'Competent, ethical, and patient-centred care delivered with accountability and respect.',
  },
  {
    icon: 'fa-solid fa-scale-balanced',
    title: 'Integrity & Stewardship',
    body: 'Honest, transparent, and prudent management of every resource entrusted to us.',
  },
  {
    icon: 'fa-solid fa-people-group',
    title: 'Teamwork & Servant Leadership',
    body: 'Collaboration, humility, and mutual respect across every department and shift.',
  },
  {
    icon: 'fa-solid fa-lightbulb',
    title: 'Adaptability & Innovation',
    body: 'Continuous learning and appropriate adoption of technology to strengthen care.',
  },
  {
    icon: 'fa-solid fa-heart',
    title: 'Christ-Centred Care',
    body: 'Reflecting the love, dignity, and hope of Christ in every patient encounter.',
  },
  {
    icon: 'fa-solid fa-hand-holding-heart',
    title: 'Compassion',
    body: 'Genuine kindness toward patients, families, and one another — every single day.',
  },
];

const whyUs = [
  {
    icon: 'fa-solid fa-graduation-cap',
    title: 'Continuing professional development',
    body: 'Structured CPD, clinical mentorship, and access to specialist training pathways.',
  },
  {
    icon: 'fa-solid fa-shield-heart',
    title: 'Comprehensive staff benefits',
    body: 'Medical cover, paid leave, performance recognition, and wellness support.',
  },
  {
    icon: 'fa-solid fa-house-medical',
    title: 'Modern clinical environment',
    body: 'Well-equipped wards, theatre, diagnostics, maternity, and emergency units.',
  },
  {
    icon: 'fa-solid fa-hands-praying',
    title: 'Purpose-driven workplace',
    body: 'Every role — clinical or administrative — contributes to healing and hope.',
  },
  {
    icon: 'fa-solid fa-users',
    title: 'Supportive team culture',
    body: 'Open communication, peer support, and leadership that listens to staff.',
  },
  {
    icon: 'fa-solid fa-seedling',
    title: 'Rooted in community',
    body: 'Serve families across Homa Bay County and see your work change lives locally.',
  },
];

const testimonials = [
  {
    quote:
      "I joined as a junior Theatre Tech 2 years ago. The mentorship here is unmatched — I've grown into a theatre lead, and the hospital supported every step of my training.",
    name: 'Ronah Gesare',
    role: 'Theatre Technologist',
    initials: 'RG',
  },
  {
    quote:
      'Working here feels like being part of a family. When I needed flexible hours after my second child, leadership made it work without compromising my career.',
    name: 'Jemima Nasimiyu',
    role: 'Health Records Officer',
    initials: 'JN',
  },
  {
    quote:
      'What drew me was the mission. What keeps me is the people. The doctors, the cleaners, the kitchen team — everyone is here for the same reason.',
    name: 'Evans Oguta',
    role: 'Laboratory Technologist',
    initials: 'EO',
  },
  {
    quote:
      "In the finance department, I see how careful stewardship allows us to keep care affordable for the poorest families. That's a rare privilege.",
    name: 'Recho Adhiambo',
    role: 'Claims Officer',
    initials: 'RA',
  },
];

const stats = [
  { value: '250K+', label: 'Catchment population served' },
  { value: '24/7', label: 'Emergency & maternity services' },
  { value: '20+', label: 'Clinical & support disciplines' },
  { value: '100%', label: 'Committed to dignified care' },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: "St. Paul's Mission Hospital",
  url: 'https://www.spmh.co.ke',
  logo: 'https://recruitment.spmh.co.ke/spmh-logo.png',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Homa Bay',
    addressCountry: 'KE',
  },
};

const jobListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: preparedJobs.map((job, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://recruitment.spmh.co.ke/jobs/${job.slug}`,
  })),
};
---

<PublicLayout
  title="Careers | St. Paul's Mission Hospital"
  description="Build a meaningful career in healthcare at St. Paul's Mission Hospital, Homa Bay. Explore clinical, administrative, and community roles."
  canonicalPath='/'>
  <script type='application/ld+json' set:html={JSON.stringify(orgSchema)} />
  <script type='application/ld+json' set:html={JSON.stringify(jobListSchema)} />

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- HERO                                                        -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='relative overflow-hidden bg-[#141416] text-white'>
    <img
      src='/img/8.jpg'
      alt=''
      class='absolute inset-0 w-full h-full object-cover opacity-45'
      aria-hidden='true'
    />
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#860f0f]/85 via-[#141416]/85 to-[#141416]/95'
      aria-hidden='true'>
    </div>
    <div
      class='absolute inset-0 opacity-[0.08]'
      style='background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;'
      aria-hidden='true'>
    </div>

    <div
      class='relative max-w-6xl mx-auto px-6 sm:px-10 pt-20 sm:pt-28 pb-20 sm:pb-28'>
      <div class='max-w-3xl'>
        <p
          class='text-[11px] font-bold uppercase tracking-[0.3em] text-white/55 mb-6'>
          St. Paul's Mission Hospital · Homa Bay
        </p>

        <h1
          class='text-[2.25rem] sm:text-5xl lg:text-[3.5rem] font-black tracking-[-0.025em] leading-[1.06] mb-7'>
          A career that heals.<br />
          A team that cares.
        </h1>

        <p
          class='text-[15px] sm:text-[17px] text-white/75 leading-[1.75] max-w-2xl mb-10'>
          Join a faith-based, Level IV mission hospital serving families across
          Homa Bay County. Whether you are a clinician, administrator, or just
          beginning your career — there is a place for you here.
        </p>

        <div class='flex flex-wrap items-center gap-3'>
          <a
            href='#openings'
            class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-[var(--color-ink)] text-sm font-bold hover:bg-white/90 transition-colors'>
            View open positions
            <i class='fa-solid fa-arrow-down text-[11px]'></i>
          </a>
          <a
            href='/who-we-are'
            class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-white/25 text-white text-sm font-bold hover:border-white/50 transition-colors'>
            About St. Paul's
            <i class='fa-solid fa-arrow-right text-[11px]'></i>
          </a>
        </div>
      </div>

      <!-- Stats strip -->
      <dl
        class='mt-20 pt-10 border-t border-white/10 grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-8'>
        {
          stats.map((s) => (
            <div>
              <dd class='text-2xl sm:text-3xl font-black tracking-tight text-white mb-2'>
                {s.value}
              </dd>
              <dt class='text-[11px] font-semibold uppercase tracking-[0.18em] text-white/45 leading-snug'>
                {s.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- VALUES                                                      -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='bg-white border-b border-[var(--color-border-soft)]'>
