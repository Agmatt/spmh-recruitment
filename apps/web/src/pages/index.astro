        <!-- Right: list -->
        <ul class='space-y-4'>
          {
            whyUs.map((item) => (
              <li class='flex items-start gap-5 p-5 rounded-2xl border border-[var(--color-border-soft)] bg-[var(--color-warm)]/40 hover:bg-white hover:shadow-md transition-all duration-200'>
                <div class='w-11 h-11 rounded-xl bg-white border border-[var(--color-border-soft)] flex items-center justify-center shrink-0 text-[var(--color-brand)]'>
                  <i class={`${item.icon} text-[16px]`} aria-hidden='true' />
                </div>
                <div class='min-w-0'>
                  <h3 class='text-[15px] font-bold text-[var(--color-ink)] mb-1.5'>
                    {item.title}
                  </h3>
                  <p class='text-[13px] text-gray-500 leading-[1.7]'>
                    {item.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- TESTIMONIALS CAROUSEL                                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='relative overflow-hidden bg-[#141416] text-white'>
    <img
      src='/gallery/3.jpg'
      alt=''
      class='absolute inset-0 w-full h-full object-cover opacity-20'
      aria-hidden='true'
    />
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#141416]/95 via-[#141416]/90 to-[#860f0f]/40'
      aria-hidden='true'>
    </div>

    <div
      class='relative max-w-4xl mx-auto px-4 sm:px-10 py-8 md:py-24 sm:py-28 text-center'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.28em] text-white/55 mb-8'>
        Voices from our team
      </p>

      <div class='relative min-h-[300px] sm:min-h-[260px]' data-testimonials>
        {
          testimonials.map((t, i) => (
            <blockquote data-slide class='testimonial-slide'>
              <p class='text-lg sm:text-2xl font-medium leading-[1.5] text-white/95 mb-8 tracking-[-0.005em]'>
                "{t.quote}"
              </p>
              <footer class='flex items-center justify-center gap-3.5'>
                <div class='w-11 h-11 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-[12px] font-bold text-white shrink-0'>
                  {t.initials}
                </div>
                <div class='text-left'>
                  <p class='text-[13px] font-bold text-white leading-tight'>
                    {t.name}
                  </p>
                  <p class='text-[11px] text-white/55 mt-0.5'>{t.role}</p>
                </div>
              </footer>
            </blockquote>
          ))
        }
      </div>

      <div
        class='flex items-center justify-center gap-2 mt-4 md:mt-10'
        data-dots>
        {testimonials.map((_, i) => <span class='dot' data-dot />)}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- CLOSING CTA                                                 -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='bg-white border-t border-[var(--color-border-soft)]'>
    <div class='max-w-4xl mx-auto px-4 sm:px-10 py-20 sm:py-24 text-center'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.28em] text-[var(--color-brand)] mb-5'>
        Join us
      </p>
      <h2
        class='text-[1.75rem] sm:text-4xl font-black tracking-[-0.02em] text-[var(--color-ink)] leading-[1.15] mb-6'>
        Ready to make a difference in Homa Bay?
      </h2>
      <p
        class='text-[14px] sm:text-[15px] text-gray-500 leading-[1.75] max-w-xl mx-auto mb-10'>
        Whether you're applying for an open position or sending a speculative
        application, our Human Resources team is ready to hear from you.
      </p>

      <div class='flex flex-wrap items-center justify-center gap-3'>
        <a
          href='#openings'
          class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--color-brand)] text-white text-sm font-bold hover:bg-[var(--color-brand-hover)] transition-colors'>
          Browse openings
          <i class='fa-solid fa-arrow-right text-[11px]'></i>
        </a>
        <a
          href='mailto:recruitment@spmh.co.ke'
          class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-[var(--color-border-soft)] text-[var(--color-ink)] text-sm font-bold hover:border-[var(--color-brand)] transition-colors'>
          <i class='fa-solid fa-envelope text-[12px]'></i>
          Email HR
        </a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .testimonial-slide {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
  }
  .testimonial-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    position: relative;
    pointer-events: auto;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.4s ease;
  }
  .dot.is-active {
    width: 22px;
    background: rgba(255, 255, 255, 0.85);
  }
</style>

<script>
  (function () {
    var track = document.querySelector('[data-testimonials]');
    var dotsWrap = document.querySelector('[data-dots]');
    if (!track) return;

    var slides = track.querySelectorAll('[data-slide]');
    var dots = dotsWrap ? dotsWrap.querySelectorAll('[data-dot]') : [];
    if (slides.length < 2) {
      if (slides[0]) slides[0].classList.add('is-active');
      if (dots[0]) dots[0].classList.add('is-active');
      return;
    }

    var idx = 0;
    slides[0].classList.add('is-active');
    if (dots[0]) dots[0].classList.add('is-active');

    setInterval(function () {
      slides[idx].classList.remove('is-active');
      if (dots[idx]) dots[idx].classList.remove('is-active');

      idx = (idx + 1) % slides.length;

      slides[idx].classList.add('is-active');
      if (dots[idx]) dots[idx].classList.add('is-active');
    }, 6000);
  })();
</script>
