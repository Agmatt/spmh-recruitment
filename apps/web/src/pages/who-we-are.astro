---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Who We Are | St. Paul's Mission Hospital"
  description="St. Paul's Mission Hospital is a faith-based Level IV referral hospital in Homa Bay, Kenya, owned by the Catholic Diocese of Homa Bay."
  canonicalPath='/who-we-are'>
  <section class='border-b border-[var(--color-border-soft)]'>
    <div class='max-w-4xl mx-auto px-6 sm:px-10 pt-20 sm:pt-28 pb-14 sm:pb-20'>
      <p
        class='text-[11px] font-bold uppercase tracking-[0.28em] text-[var(--color-brand)] mb-5'>
        About us
      </p>
      <h1
        class='text-[2rem] sm:text-5xl font-black tracking-[-0.025em] leading-[1.08] text-[var(--color-ink)] mb-7'>
        Who we are.
      </h1>
      <p
        class='text-[15px] sm:text-[17px] text-gray-600 leading-[1.75] max-w-3xl'>
        St. Paul's Mission Hospital is a faith-based, Level IV referral hospital
        owned by the Catholic Diocese of Homa Bay and operating within Kenya's
        national health system. We serve the people of Homa Bay County and
        surrounding regions with compassion, dignity, and clinical excellence.
      </p>
    </div>
  </section>

  <section class='bg-white border-b border-[var(--color-border-soft)]'>
    <div class='max-w-4xl mx-auto px-6 sm:px-10 py-16 sm:py-20 space-y-12'>
      <div>
        <h2
          class='text-[1.25rem] sm:text-[1.5rem] font-black tracking-[-0.015em] text-[var(--color-ink)] mb-4'>
          Our mission
        </h2>
        <p class='text-[15px] text-gray-600 leading-[1.8]'>
          To deliver high-quality, affordable, and compassionate healthcare that
          upholds human dignity and equity, while faithfully advancing the
          healing mission of Christ.
        </p>
      </div>

      <div>
        <h2
          class='text-[1.25rem] sm:text-[1.5rem] font-black tracking-[-0.015em] text-[var(--color-ink)] mb-4'>
          Our vision
        </h2>
        <p class='text-[15px] text-gray-600 leading-[1.8]'>
          A centre of excellence in integrated and compassionate healthcare.
        </p>
      </div>

      <div>
        <h2
          class='text-[1.25rem] sm:text-[1.5rem] font-black tracking-[-0.015em] text-[var(--color-ink)] mb-4'>
          Our role in the health system
        </h2>
        <p class='text-[15px] text-gray-600 leading-[1.8] mb-4'>
          As a Level IV facility, we bridge the gap between community health
          services, primary care, and higher-level referral hospitals. We
          receive referrals from dispensaries and health centres, provide
          essential inpatient, surgical, maternity, and emergency services, and
          refer complex cases onward to county and national referral facilities.
        </p>
        <p class='text-[15px] text-gray-600 leading-[1.8]'>
          We serve a catchment population of approximately 250,000 people with a
          mix of urban, peri-urban, and rural access needs.
        </p>
      </div>

      <div>
        <h2
          class='text-[1.25rem] sm:text-[1.5rem] font-black tracking-[-0.015em] text-[var(--color-ink)] mb-4'>
          Our commitment to staff
        </h2>
        <p class='text-[15px] text-gray-600 leading-[1.8] mb-4'>
          We believe that caring for patients begins with caring for our people.
          Whether you are a clinician, administrator, technician, or support
          staff member, you are part of the healing mission of this institution.
        </p>
        <p class='text-[15px] text-gray-600 leading-[1.8]'>
          We invest in your professional development, protect your wellbeing,
          and provide a working environment where competence, ethics, and
          compassion are valued equally.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class='max-w-4xl mx-auto px-6 sm:px-10 py-16 sm:py-20 text-center'>
      <h2
        class='text-[1.25rem] sm:text-[1.5rem] font-black tracking-[-0.015em] text-[var(--color-ink)] mb-5'>
        Ready to explore opportunities with us?
      </h2>
      <div class='flex flex-wrap items-center justify-center gap-3'>
        <a
          href='/#openings'
          class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--color-brand)] text-white text-sm font-bold hover:bg-[var(--color-brand-hover)] transition-colors'>
          View open positions
          <i class='fa-solid fa-arrow-right text-[11px]'></i>
        </a>
        <a
          href='https://www.spmh.co.ke'
          target='_blank'
          rel='noopener'
          class='inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-[var(--color-border-soft)] text-[var(--color-ink)] text-sm font-bold hover:border-[var(--color-brand)] transition-colors'>
          Visit main website
        </a>
      </div>
    </div>
  </section>
</PublicLayout>
